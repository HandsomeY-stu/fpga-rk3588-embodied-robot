//===【新增】JY901S 姿态模块串口输入 ======================================
// A13 = 扩展口 GPIO0_0（ACG720-138&60K通用管脚分配表）
// PULL_MODE=UP：串口空闲是高电平，加上拉可以避免悬空时被干扰出假起始位
// ★ 该 bank 的 VCCIO 是板上有跳线可选的（3.3/1.5/1.8/2.5V），
//   接 JY901S 时必须确认是 3.3V，否则电平不匹配
IO_LOC "imu_rx" A13;
IO_PORT "imu_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "reset_n" F15;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "clk50M" Y18;
IO_PORT "clk50M" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//=== [B] 运动·避障·导航 ==============================================
// 电机 PWM + 方向（TB6612 三线制：IN1 = motor_dir，IN2 = motor_dirn）
IO_LOC "motor_pwm[0]" A15;  IO_PORT "motor_pwm[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_dir[0]" A16;  IO_PORT "motor_dir[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_pwm[1]" A18;  IO_PORT "motor_pwm[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_dir[1]" A19;  IO_PORT "motor_dir[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
//   ★ 2026-10-07 18:40 【决定：不动线，E13/E14 保持原状】
//     · 曾计划把 E13/E14 "让给 C 的超声波 ch1"（先试 E18/F18，再试 D16/F20）。
//     · 🔴 **最终撤回**：C 的 `algo_top` 只吃**一路** `DistMm`（靠"原地旋转探测"补侧向），
//       而**用户实物已接的超声波是「前 C13/C14 + 后 D20/F18」**（与本工程一致）
//       ⇒ **根本不需要 E13/E14**，让脚这件事没有收益，却要挪一根正在用的线（右轮 BIN2）。
//       ⇒ 回到**已上板验证过（D1~D6 全过）的原始引脚**，硬件零改动、零风险。
//     · 若将来真需要第三个超声波通道，再回来动（届时只需挪 BIN2 一根线到 F20/P7-40）。
//   引脚用途（TB6612 三线制：IN1 = motor_dir，IN2 = motor_dirn）：
//     motor_pwm[0] A15 P7-3 -> PWMA   左轮 PWM      motor_dir[0] A16 P7-4 -> AIN1
//     motor_pwm[1] A18 P7-5 -> PWMB   右轮 PWM      motor_dir[1] A19 P7-6 -> BIN1
//     motor_dirn[2] F14 P7-8 -> AIN2  左轮方向取反（借 M2 DIR 脚）
//     motor_dirn[3] E14 P7-10 -> BIN2 右轮方向取反（借 M3 DIR 脚）
IO_LOC "motor_pwm[2]" F19;  IO_PORT "motor_pwm[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_pwm[3]" E13;  IO_PORT "motor_pwm[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_dirn[2]" F14; IO_PORT "motor_dirn[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_dirn[3]" E14; IO_PORT "motor_dirn[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Unwired directions for the unused two motor outputs must still be constrained.
// ★ 2026-10-13：motor_dir[2] 原占 E16 —— E16/D16 是 UART1 预留脚
//   （car_defines.vh: PIN_UART1_TX=E16 / PIN_UART1_RX=D16），已让位给 RK3588 通信。
//   motor_dir[2] 本身【未接线】，只要求"有个合法约束"，故挪到 Bank1 空闲脚 F13。
IO_LOC "motor_dir[2]" F13;  IO_PORT "motor_dir[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_dir[3]" B22;  IO_PORT "motor_dir[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//===【C】RK3588 视觉指令桥 UART1（115200 8N1）=========================
//  ★ 2026-10-16 批次 008：UART1 引脚重分配（原 E16/D16 -> 新 E18/C20）
//  FPGA uart1_tx = P7-38(E18)  -> RK3588 J423 PIN8 (RX0)   [FPGA -> RK]
//  FPGA uart1_rx = P7-34(C20)  <- RK3588 J423 PIN7 (TX0)   [RK -> FPGA]
//  共地 GND: FPGA P8-8 <-> J423 PIN17（P8-8 是固定 GND 网络，不写入 cst）
//  ★ 3.3V TTL，TX/RX 交叉；uart1_tx 输出保留 DRIVE=8，uart1_rx 输入不写 DRIVE
//  ★ 切勿占用 P7-13(C13)/P7-14(C14)（实物超声波）；切勿接 P7-11（5V）
//  ★ E16/D16 已不再由 UART 占用（旧线束保持原状）；E19/D19 不使用（CFG/禁用脚）
//=====================================================================
IO_LOC "uart1_tx" E18; IO_PORT "uart1_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart1_rx" C20; IO_PORT "uart1_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

//===【D】串口遥测（2026-10-19 新增，移植自 C 同学 seg1_test 工装）=========
//  FPGA uart_tx = M15 -> 板载 CH340E RX（丝印 UART 那个 USB 口）
//  115200 8N1，5Hz，'#' + 40 hex + CRLF
//  ★ 与 UART1(E18/C20 → RK3588) 是两路独立串口，互不影响
//  ★ 输出脚保留 DRIVE=8；PULL_MODE=NONE 与工装一致
//=========================================================================
IO_LOC "uart_tx" M15; IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Encoders
IO_LOC "enc_a0" B15; IO_PORT "enc_a0" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b0" B16; IO_PORT "enc_b0" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_a1" D17; IO_PORT "enc_a1" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b1" C17; IO_PORT "enc_b1" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ============================================================================
// [3] 超声波（任务三「实时避障」）—— 2026-10-15 集成
//   ch0（前）TRIG=C13(P7-13) / ECHO=C14(P7-14)
//   ch1（后）TRIG=D20(P7-33) / ECHO=F18(P7-37)  ← 后退「后方保护」
//   ★ 与独立工装 avoid_test 用的**同一组实物引脚**，硬件零改动。
//   ★ ch2（备用）不引出：原定 F19 在本工程被 motor_pwm[2] 占用，且实物无传感器。
//   ★ TRIG 是【输出】才写 DRIVE；ECHO 是【输入】——绝不能写 DRIVE，否则 CT1108。
//   ★ 输入一律 PULL_MODE=UP：没插传感器时不会悬空乱跳。
//   ★★ ECHO 电平：模块若 5V 供电，ECHO 输出 5V ⇒ 必须 1kΩ/2kΩ 分压后再接！
// ============================================================================
IO_LOC "us_trig0" C13; IO_PORT "us_trig0" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "us_echo0" C14; IO_PORT "us_echo0" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "us_trig1" D20; IO_PORT "us_trig1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "us_echo1" F18; IO_PORT "us_echo1" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// On-board keys (active-low)
IO_LOC "key[0]" A20; IO_PORT "key[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key[1]" B20; IO_PORT "key[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key[2]" A21; IO_PORT "key[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key[3]" B21; IO_PORT "key[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// B uses LED4..LED7; A retains LED0..LED3.
IO_LOC "beep" N19; IO_PORT "beep" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "bled[0]" K22; IO_PORT "bled[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "bled[1]" J22; IO_PORT "bled[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "bled[2]" H22; IO_PORT "bled[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "bled[3]" M21; IO_PORT "bled[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// ============================================================================
// [6] ★ 板载 74HC595 八位数码管（三线制）—— 2026-10-15 新增
//   与独立工装 avoid_test / pid_diag / enc_test / ir_test 用的是**同一组脚本引脚**
//   （板载、非外接模块）。三个都是【输出】⇒ 要写 DRIVE；上下拉与工装一致（PULL_MODE=NONE）。
//     seg_ds   M18 -> DS    （串行数据 SER）
//     seg_shcp F4  -> SH_CP （移位时钟 SCLK）
//     seg_stcp C2  -> ST_CP （锁存时钟 RCLK）
//   ★★ 2026-10-15 修正：**C2 / F4 一开始被接反了**（把 SH_CP 放 C2、ST_CP 放 F4），
//      症状是数码管"发光很淡、像没显示" —— 因为移位时钟和锁存时钟对调后，
//      595 会不停锁存"只移了一半"的垃圾数据，8 位同时微亮 ⇒ 每个都变暗。
//      四个工装（avoid_test/pid_diag/enc_test/ir_test）**一致**是 st_cp=C2 / sh_cp=F4，
//      以它们为准。改引脚时务必和工装对齐，这里极容易接反且 PnR 不会报错。
// ============================================================================
IO_LOC "seg_ds"   M18; IO_PORT "seg_ds"   IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "seg_shcp" F4;  IO_PORT "seg_shcp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "seg_stcp" C2;  IO_PORT "seg_stcp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
//=== [B] END ========================================================
