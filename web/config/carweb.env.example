# Copy to /etc/robot-console.env and adapt to the board; do not commit real local configuration.
HTTP_PORT=8080
RELAY_PORT=9100
CMD_DEV=/dev/ttyS0
TLM_DEV=/dev/ttyUSB0
SPEED_MAX=24
PYTHONUNBUFFERED=1

# Optional path overrides. Defaults are resolved from the repository root.
# ROBOT_TASK_DIR=/opt/fpga-rk3588-embodied-robot/software/task6_red_bottle
# ROBOT_DETECTOR_BIN=/opt/fpga-rk3588-embodied-robot/software/detector/realtime_yolo
# ROBOT_MODEL_DIR=/opt/fpga-rk3588-embodied-robot/models
# ROBOT_GRAB_SCRIPT=/opt/fpga-rk3588-embodied-robot/software/runtime/grab_loop2.sh
# ROBOT_FRAME_SCRIPT=/opt/fpga-rk3588-embodied-robot/software/task5_follow/frame_pub.py
